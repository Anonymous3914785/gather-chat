rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Rooms ────────────────────────────────────────────────────────────────
    // Any authenticated user can read rooms.
    // Any authenticated user can create a room.
    // Only room creator can update the room name; last-message stamps are
    // allowed from any member (write only the lastMessage field).
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null;

      // ── Messages ───────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if request.auth != null;

        // Create: must supply own uid and email; no reactions on create.
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && !("reactions" in request.resource.data);

        // Update: only allowed to modify the `reactions` field.
        // Users can add/remove only their own uid inside a reaction map.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"]);

        // Delete: only message author can delete their own message.
        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Users can read any profile (for display names / avatars in chat).
    // Users can only write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Room activity (last-seen timestamps) — own data only.
      match /roomActivity/{roomId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // FCM tokens — own data only.
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
