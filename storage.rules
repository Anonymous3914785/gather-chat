rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatars ───────────────────────────────────────────────────────────────
    // Users can read any avatar (displayed in chat).
    // Users can only write to their own avatar path.
    match /avatars/{userId}.{ext} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024   // 5 MB max
        && request.resource.contentType.matches("image/.*");
    }

    // ── Message images ────────────────────────────────────────────────────────
    // Any authenticated user can read and upload message images.
    // Maximum 20 MB per image.
    match /message-images/{roomId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && request.resource.contentType.matches("image/.*");
    }
  }
}
